{
    "private": true,
    "type": "module",
    "scripts": {
        "dev:styles": "npx tailwindcss -i resources/css/index.css -o resources/dist/filament-world-map-widget.css --postcss --watch",
        "dev:scripts": "node bin/build.js --dev",
        "build:styles": "npx tailwindcss -i resources/css/index.css -o resources/dist/filament-world-map-widget.css --postcss --minify && npm run purge",
        "build:scripts": "node bin/build.js",
        "purge": "filament-purge -i resources/dist/filament-world-map-widget.css -o resources/dist/filament-world-map-widget.css -v 5.x",
        "dev": "npm-run-all --parallel dev:*",
        "build": "npm-run-all build:*"
    },
    "devDependencies": {
        "@awcodes/filament-plugin-purge": "^1.2.0",
        "@tailwindcss/postcss": "^4.0.0",
        "@tailwindcss/typography": "^0.5.10",
        "autoprefixer": "^10.4.19",
        "esbuild": "^0.20.0",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.4.38",
        "postcss-import": "^16.1.0",
        "prettier": "^3.0.0",
        "prettier-plugin-tailwindcss": "^0.5.0",
        "tailwindcss": "^4.0.0"
    },
    "dependencies": {
        "jsvectormap": "^1.6.0"
    }
}
